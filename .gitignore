# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.conda/
# 微调 ZipVoice 用的独立环境（torch 2.13 + k2 + piper_phonemize，几 GB，不进 git）
.venv-zipvoice/
# ZipVoice 官方仓库 + 预训练权重（自己 clone/下载重建，468 MB 进 git 没意义）
.zipvoice-src/
# 微调数据集（从 data/personas/kaltsit 重新生成即可）
data/finetune/
# Piper 微调（路线 C，见工程日志第 23 节）：数据集与底模/checkpoint 都能重建，不进 git
data/piper/
models/tts/piper/_train/
models/tts/piper/*.ckpt
models/tts/piper/*.pth
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env

# 模型权重：全部靠 scripts/download_models.py 下载 / 脚本导出得到，不进 git
# （whisper-large-v3-turbo-int8-ov 一个目录就 930 MB）
models/asr/whisper-large-v3-turbo-int8-ov/
models/**/*.bin
models/**/*.onnx
models/**/*.xml
models/**/*.json
models/asr/sensevoice-small/*.txt
# ZipVoice 音色克隆：模型 + espeak-ng-data（一堆小文件）+ 声码器，共 156 MB，靠下载脚本重建
models/tts/zipvoice/

# 导入/迁移脚本留下的备份（别把 .bak 提交进 git，要留就留在本地）
*.bak

# 运行产物
sessions/
data/backup/
data/ref_cache/       # 净化后的参考音频（从 data/personas 里的 wav 生成，能删）
data/vision/          # 截图/摄像头抓拍（含隐私，且是运行产物，别进 git）
*.log
# 跨进程锁（voice_loop/store.py 会在 data/*.json 旁边建 x.json.lock）与原子写的临时文件：
# 它们是运行时状态，谁都不该提交（提交了反而让下一个人以为文件被锁着）。
*.lock
*.json.tmp

# 个人数据（日程 / 备忘 / 旧版闹钟与课程表）：这是真实生活安排，只留本地，永不入库。
# 已从全部 git 历史里剔除（见 docs/ENGINEERING_LOG.md），别再用 git add 加回来。
data/events.json
data/memos.json
data/alarms.json
data/schedule.json
data/*.bak            # 迁移时旧文件的改名备份，内容同样是个人日程

# 训练用的外部仓库与独立环境（小则几十 MB，大则几个 GB）
.venv-zipvoice/
.venv-piper/
.zipvoice-src/
.piper-src/
.piper1-src/
data/finetune/

# 角色素材音频：44 MB 的配音 wav，只放本地（同目录的 *.txt 清单要进 git，那是台词文本）
data/personas/*/*.wav
*.wav

# 编辑器
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# 提交信息临时文件（git commit -F commitmsg.txt 用的，别入库）
commitmsg.txt

# 看图拍下来的画面（屏幕截图 / 摄像头照片都是隐私，绝不入库）
data/vision/

# ★记忆是隐私，绝不入库★（跟 §31 的日程事故同一个道理）：
#   记的是你和它聊过什么、你的偏好、你的日程 —— 而且这个仓库是公开的。
#   删掉本地文件就等于失忆，但删错了也回不来，所以宁可它不在版本库里。
data/memory/

# 你放进去的知识库资料：说明文件（下划线开头）只留模板，别的都当私人资料挡在外面。
# （想公开某一本，就 `git add -f data/knowledge/xxx.md` 显式加。）
data/knowledge/*
!data/knowledge/_README.md
