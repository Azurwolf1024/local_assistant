# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.conda/
# 微调 ZipVoice 用的独立环境（torch 2.13 + k2 + piper_phonemize，几 GB，不进 git）
.venv-zipvoice/
# ZipVoice 官方仓库 + 预训练权重（自己 clone/下载重建，468 MB 进 git 没意义）
.zipvoice-src/
# 微调数据集（从 data/personas/kaltsit 重新生成即可）
data/finetune/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env

# 模型权重：全部靠 scripts/download_models.py 下载 / 脚本导出得到，不进 git
# （whisper-large-v3-turbo-int8-ov 一个目录就 930 MB）
models/asr/whisper-large-v3-turbo-int8-ov/
models/**/*.bin
models/**/*.onnx
models/**/*.xml
models/**/*.json
models/asr/sensevoice-small/*.txt
# ZipVoice 音色克隆：模型 + espeak-ng-data（一堆小文件）+ 声码器，共 156 MB，靠下载脚本重建
models/tts/zipvoice/

# 导入/迁移脚本留下的备份（别把 .bak 提交进 git，要留就留在本地）
*.bak

# 运行产物
sessions/
data/backup/
data/ref_cache/       # 净化后的参考音频（从 data/personas 里的 wav 生成，能删）
data/vision/          # 截图/摄像头抓拍（含隐私，且是运行产物，别进 git）
*.log

# 训练用的外部仓库与独立环境（小则几十 MB，大则几个 GB）
.venv-zipvoice/
.venv-piper/
.zipvoice-src/
.piper-src/
.piper1-src/
data/finetune/

# 角色素材音频：44 MB 的配音 wav，只放本地（同目录的 *.txt 清单要进 git，那是台词文本）
data/personas/*/*.wav
*.wav

# 编辑器
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# 提交信息临时文件（git commit -F commitmsg.txt 用的，别入库）
commitmsg.txt

# 看图拍下来的画面（屏幕截图 / 摄像头照片都是隐私，绝不入库）
data/vision/
